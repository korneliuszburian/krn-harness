{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex SessionStart",
            "statusMessage": "KRN session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex UserPromptSubmit",
            "statusMessage": "KRN prompt guardrail"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex PreToolUse",
            "statusMessage": "KRN pre-tool guardrail"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex PostToolUse",
            "statusMessage": "KRN post-tool guardrail"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex PreCompact",
            "statusMessage": "KRN pre-compact guardrail"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex PostCompact",
            "statusMessage": "KRN post-compact trace"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.krn/bin/krn hook codex Stop",
            "statusMessage": "KRN final guardrail"
          }
        ]
      }
    ]
  }
}
