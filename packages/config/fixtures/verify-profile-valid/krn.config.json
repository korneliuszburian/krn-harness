{
  "version": 1,
  "verify": {
    "defaultProfile": "unit",
    "mode": "record-only",
    "timeoutMs": 30000,
    "maxOutputBytes": 4096,
    "profiles": {
      "unit": {
        "commands": [
          {
            "command": "node",
            "args": ["src/index.test.ts"],
            "label": "fixture unit test"
          }
        ]
      },
      "quality": {
        "commands": ["pnpm lint", "pnpm typecheck", "pnpm test"]
      }
    }
  }
}
