          "patch": "*** Begin Patch\n*** Update File: src/in-scope.ts\n@@\n+test\n*** End Patch\n"
        }
      },
      "expected": {
        "status": "blocked",
        "decision": "block",
        "findingCodes": ["missing-task-contract", "missing-context-package"]
      }
    },
